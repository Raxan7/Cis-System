{
  "Database": {
    "InitializeOnStartup": false,
    "ApplyMigrationsOnStartup": true
  },
  "OperationalReadiness": {
    "Environment": "UAT",
    "RtoMinutes": 120,
    "RpoMinutes": 240,
    "BackupDirectory": "/var/backups/victory-cis/uat"
  },
  "Storage": {
    "LocalPath": "/var/lib/victory-cis/storage"
  },
  "Integrations": {
    "LocalStoragePath": "/var/lib/victory-cis/storage"
  },
  "BackgroundJobs": {
    "Provider": "Quartz",
    "DashboardEnabled": true,
    "DashboardAdminRole": "SystemAdmin"
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": [
        "https://uat-investors.victoryfs.example",
        "https://uat-admin.victoryfs.example"
      ]
    },
    "FileUploads": {
      "MaxSizeBytes": 10485760
    },
    "Mfa": {
      "RequireForPrivilegedRoles": true
    }
  }
}
