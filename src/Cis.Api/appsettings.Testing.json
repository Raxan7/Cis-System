{
  "Database": {
    "InitializeOnStartup": true,
    "ApplyMigrationsOnStartup": true
  },
  "OperationalReadiness": {
    "Environment": "Testing",
    "RtoMinutes": 240,
    "RpoMinutes": 1440,
    "BackupDirectory": "ops/testing/backups"
  },
  "Storage": {
    "LocalPath": "integration-storage-testing"
  },
  "Integrations": {
    "LocalStoragePath": "integration-storage-testing"
  },
  "BackgroundJobs": {
    "Provider": "Quartz",
    "DashboardEnabled": true,
    "DashboardAdminRole": "SystemAdmin"
  },
  "Performance": {
    "BackgroundQueueCapacity": 128,
    "HeavyImportLineThreshold": 200,
    "HeavyReconciliationLineThreshold": 200,
    "HeavyNavInstrumentThreshold": 50,
    "HeavyReportOutputThreshold": 2,
    "HeavyReportCodePrefixes": [ "REG-", "MGT-", "NAV-" ]
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": [ "http://localhost:3000" ]
    },
    "RateLimiting": {
      "GlobalPermitLimit": 1000,
      "GlobalWindowSeconds": 60,
      "PublicAuthPermitLimit": 1000,
      "PublicAuthWindowSeconds": 60,
      "PublicEndpointPermitLimit": 1000,
      "PublicEndpointWindowSeconds": 60
    },
    "FileUploads": {
      "MaxSizeBytes": 10485760
    },
    "Mfa": {
      "RequireForPrivilegedRoles": false
    }
  },
  "Portal": {
    "SelfRegistration": {
      "FixedOtpCode": "000000",
      "OtpLength": 6,
      "OtpExpiryMinutes": 10,
      "MaxFailedOtpAttempts": 5
    }
  }
}
