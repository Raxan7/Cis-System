# Local development
# Leave this unset to use the built-in localhost:8080 fallback in src/lib/http.ts.
# If you want the Vite dev server proxy to target a different backend, set this.
VITE_PROXY_TARGET=http://localhost:8080

# Production / Vercel
# Set this in Vercel so the built frontend talks to the deployed backend.
# Example:
# VITE_API_BASE_URL=https://cis-api-n4ryz2zhlq-uc.a.run.app
VITE_API_BASE_URL=